PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

JWT_SECRET=
# Thời hạn phiên đăng nhập (app tự gia hạn mỗi lần mở) — vd 30d, 60d
SESSION_TTL=30d
# ── Trợ lý AI (Gemini) ── lấy key tại https://aistudio.google.com/apikey
# Để trống / giữ giá trị mẫu → trợ lý chạy chế độ cơ bản (không AI)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Model chính + model dự phòng (cách nhau dấu phẩy) khi model chính quá tải / không khả dụng
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# 0 = bám sát dữ liệu nhất; mặc định 0.2
GEMINI_TEMPERATURE=0.2
# Bật "suy nghĩ" để chọn công cụ chính xác hơn (chậm hơn ~1-2s). 0 = tắt
GEMINI_THINKING_BUDGET=0
# Thời gian chờ tối đa mỗi lần gọi Gemini (ms)
GEMINI_TIMEOUT_MS=20000
# Số lượt hỏi trợ lý tối đa mỗi 5 phút cho 1 tài khoản / 1 IP
ASSISTANT_RATE_LIMIT=30

# ── Lưu ảnh món ăn (Supabase Storage) ──
# Supabase Dashboard → Project Settings → API Keys → service_role (secret). CHỈ để ở backend.
SUPABASE_SERVICE_ROLE_KEY=
# Để trống → tự suy ra từ DB_USER dạng postgres.<project-ref>
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=recipe-images
